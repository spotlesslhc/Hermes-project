{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hermes-project",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "public",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "HERMES_KV",
      "id": "3fc1aeb7a68049ea98d94eac2e06c07d"
    }
  ],
  "secrets_store_secrets": [
    {
      "binding": "ANTHROPIC_API_KEY",
      "store_id": "8f15d6429b5741f9ac32e05415413a65",
      "secret_name": "ANTHROPIC_API_KEY"
    },
    {
      "binding": "GITHUB_TOKEN",
      "store_id": "8f15d6429b5741f9ac32e05415413a65",
      "secret_name": "GITHUB_TOKEN"
    },
    {
      "binding": "WAVE_API_TOKEN",
      "store_id": "8f15d6429b5741f9ac32e05415413a65",
      "secret_name": "WAVE_API_TOKEN"
    }
    // Once you've created ELEVENLABS_API_KEY in the Secrets Store (see
    // README.md "4b"), add it here too, in the same shape as the entries
    // above. Deliberately left out until the secret actually exists —
    // binding to a secret that isn't there yet can fail the whole deploy,
    // not just voice. Until then /api/speak just falls back to the
    // browser's built-in voice.
  ],
  "vars": {
    "HERMES_DEBUG_TOOLS": "false"
  }
}
