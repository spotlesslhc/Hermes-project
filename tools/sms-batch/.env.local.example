# Copy this file to .env.local (gitignored) and fill in the real values.

# Cloudflare Access Service Token -- same "Hermes_Cloudflare Auth" token
# tools/deja-bridge already uses (Zero Trust dashboard -> Access -> Service
# Auth -> Service Tokens). If you've already filled in
# tools/deja-bridge/.env.local, you can leave these blank here -- the
# scripts fall back to that file automatically.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Same bot token stored as the Worker's TELEGRAM_BOT_TOKEN secret, and
# Bryce's Telegram chat id (same as the Worker's TELEGRAM_CHAT_ID var).
# Only used by notify-telegram.mjs to tell Bryce texts are staged.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
